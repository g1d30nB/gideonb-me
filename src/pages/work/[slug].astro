---
// One route for the four case pages and the three project pages. The slugs come from
// CASES and PROJECTS in src/lib/work.mjs, so the hub, the redirect shim and this file agree.
import Base from '../../layouts/Base.astro';
import Footer from '../../layouts/Footer.astro';
import Plate from '../../components/work/Plate.astro';
import '../../styles/work.css';
import { loadWork, CASES, PROJECTS, caseHref } from '../../lib/work.mjs';
import CaseOne from '../../components/work/sections/CaseOne.astro';
import CaseTwo from '../../components/work/sections/CaseTwo.astro';
import CaseThree from '../../components/work/sections/CaseThree.astro';
import CaseFour from '../../components/work/sections/CaseFour.astro';
import Contact from '../../components/work/sections/Contact.astro';

export function getStaticPaths() {
  return [
    ...CASES.map((c) => ({ params: { slug: c.slug }, props: { kind: 'case', n: c.n, og: c.og } })),
    ...PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { kind: 'project', key: p.key } })),
  ];
}
const { kind, n, og, key } = Astro.props;
const w = loadWork();
const CaseSection = [CaseOne, CaseTwo, CaseThree, CaseFour][n - 1];
const c = w.cases[n - 1];
const project = w.projects.find((p) => p.key === key);
const firstSentence = (s) => s.split(/(?<=\.)\s/)[0];
const title = kind === 'case' ? `${c.info.title} · Gideon Bullock` : `${project.name} · Gideon Bullock`;
const description = kind === 'case' ? c.info.role : firstSentence(project.description);
const ogImage = kind === 'case' ? og : project.image;
const others = kind === 'case' ? CASES.filter((x) => x.n !== n) : [];
const external = (l) => /^https?:/.test(l);
---
<Base title={title} description={description} ogImage={ogImage} path={`/work/${Astro.params.slug}/`} nav="work">
  <main id="work-page" class="page active wk">
    {kind === 'case' && (
      <Fragment>
        <div class="wk-frame wk-crumb"><a href="/work/">Work &amp; Projects</a></div>
        <CaseSection w={w} extended />
        <div class="wk-frame wk-more"><p class="lbl">The other cases</p><div>{others.map((o) => <a href={caseHref(o.n)}>{w.cases[o.n - 1].info.number}<span>{w.cases[o.n - 1].info.title}</span></a>)}</div></div>
      </Fragment>
    )}
    {kind === 'project' && (
      <Fragment>
        <div class="wk-frame wk-crumb"><a href="/work/">Work &amp; Projects</a></div>
        <div class="wk-frame" style="padding-top:40px">
          <p class="lbl" style="margin-bottom:var(--s4)">Project</p>
          <h1 class="d1" style="margin-bottom:var(--s6)">{project.name}</h1>
          <p class="body big" style="max-width:720px">{project.description}</p>
          {project.status && <p class="t3" style="margin-top:var(--s4)">{project.status}</p>}
          {project.link && <p style="margin-top:var(--s5)"><a class="wk-card-link" href={project.link} target={external(project.link) ? '_blank' : undefined} rel={external(project.link) ? 'noopener' : undefined}>{project['link-text']} <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>}
        </div>
        <div class="wk-frame" style="padding-top:64px;padding-bottom:32px"><div class="wk-uniform" style="max-width:900px"><Plate src={project.image} what={project['image-caption']} prov={project['image-prov']} /></div></div>
      </Fragment>
    )}
    <Contact w={w} />
  </main>
  <Footer />
</Base>
