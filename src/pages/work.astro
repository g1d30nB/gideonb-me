---
import Base from '../layouts/Base.astro';
import Footer from '../layouts/Footer.astro';
import Plate from '../components/work/Plate.astro';
import { loadPage, statPairs } from '../lib/page.mjs';
import { parseKV, paragraphs, bullets, inlineMd, linkifyContact } from '../lib/homepage.mjs';
import '../styles/work.css';
import gauge from '../components/work/gauge.html?raw';
import arc from '../components/work/arc.html?raw';
import arcM from '../components/work/arc_m.html?raw';
import ownership from '../components/work/ownership.html?raw';
import people from '../components/work/people.html?raw';
import sus from '../components/work/sus.html?raw';
import rating from '../components/work/rating.html?raw';
import ctx from '../components/work/ctx.html?raw';
import timeline from '../components/work/timeline.html?raw';
import pairing from '../components/work/pairing.html?raw';

const { meta, sections } = loadPage('work.md');
const S = (k) => sections[k] || '';
const P = (k) => paragraphs(S(k));
const lead = (b) => { const m = b.match(/^\*\*(.+?)\*\*\s*(.*)$/s); return m ? { lead: m[1], body: m[2] } : { lead: '', body: b }; };
const B = (k) => bullets(S(k)).map(lead);
const c = (n) => ({ info: parseKV(S(`case${n}-meta`)), stats: statPairs(S(`case${n}-stats`)) });
const c1 = c(1), c2 = c(2), c3 = c(3), c4 = c(4);

const intro = P('intro');
const narr = P('case1-narrative');
const turnIdx = narr.findIndex((p) => p.startsWith('Service design came out of'));
const creditIdx = narr.findIndex((p) => p.startsWith('What they went on to build'));
const narr3a = narr[creditIdx - 1];
const narr3b = narr[creditIdx];
const commercial = P('case1-commercial')[0];
const com1 = commercial.split('. I ran')[0] + '.';
const com2 = 'I ran' + commercial.split('. I ran')[1];
const role2 = P('case2-role');
const hard2 = P('case2-hard');
const closing = P('closing');
const contact = P('contact');

const gaugeCards = [
  ['Case one', 'The organisation', c1.info, 'Everything here is mine. Built from nothing, run for seven years, sold engagement by engagement.', 'amber', 'fill'],
  ['Case two', 'What the organisation shipped', c2.info, 'The team I had built was already in place, run by two design managers with the client\'s trust.', 'teal', 'ring'],
  ['Case three', 'Two products, two markets', c3.info, 'Eight years at Songkick from seed to the Warner Music Group acquisition, then Dopay from concept to a live service. On both I designed the product myself and built the design team around it.', 'amber', 'fill'],
  ['Case four', 'Two AI products, built alone', c4.info, 'PrepCall, an AI voice coach I designed, built and shipped myself. Emotrix, the interpretation layer that came out of it, now in a live pilot under NDA.', 'ink', 'fill'],
];
const gov = [
  ['EU AI Act, Article 5', 'Classification and the data protection impact assessment, on a shipped product'],
  ['European Accessibility Act', 'Governance across a whole design function, turned into a four-tier service'],
  ['Regulated delivery', 'Every programme in the first two cases, and Dopay as a regulated payments product in Egypt'],
];
const colour = { amber: 'var(--amber)', teal: 'var(--teal)', ink: 'var(--ink)' };
---
<Base
  title={`${meta.title} · Gideon Bullock`}
  description="Four cases at three distances from the work: the design organisation built at Toyota, the app it shipped, two earlier products designed by hand, and two AI products built this year."
  ogImage={meta.og}
  path="/work/"
  nav="work"
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" />
  <main id="work-page" class="page active wk">

    <!-- Opening -->
    <div class="wk-frame" style="padding-top:96px">
      <p class="lbl" style="margin-bottom:var(--s4)">{meta.label}</p>
      <h1 class="d1" style="margin-bottom:var(--s6)">{meta.title}</h1>
      <p style="font-size:21px;line-height:1.65;color:var(--body);max-width:720px;margin-bottom:var(--s5)" set:html={inlineMd(intro[0])} />
      <p style="font-size:16px;line-height:1.8;color:var(--muted);max-width:720px" set:html={inlineMd(intro[1])} />
    </div>
    <div class="wk-frame" style="padding-top:64px;padding-bottom:96px">
      <div class="wk-desk"><Fragment set:html={gauge} /></div>
      <div class="wk-gauge">
        {gaugeCards.map(([n, t, info, note, col, kind]) => (
          <div>
            <div class="wk-lab" style={`--c:${colour[col]};margin-bottom:var(--s2)`}><p class="lbl">{n}</p></div>
            <p class="d4">{t}</p>
            <p class="t3">{info.company} &nbsp;·&nbsp; {info.dates}</p>
            <p class="t2">{note}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:var(--s7);padding-top:var(--s5);border-top:1px solid var(--rule);max-width:840px"><p class="t3" style="font-size:14px" set:html={inlineMd(intro[2])} /></div>
    </div>

    <!-- Case one -->
    <section class="wk-band wk-video reveal">
      <video class="wk-video-src" autoplay muted loop playsinline preload="metadata" poster="/video/txd-poster.jpg" aria-hidden="true"><source src="/video/txd.mp4" type="video/mp4" /></video>
      <div class="wk-video-wash" aria-hidden="true"></div>
      <script is:inline>document.querySelectorAll('.wk-video-src').forEach((v) => { v.playbackRate = 0.4; v.addEventListener('play', () => { v.playbackRate = 0.4; }); const ready = () => v.classList.add('is-ready'); if (v.readyState >= 3) ready(); else v.addEventListener('canplay', ready, { once: true }); });</script>
      <div class="wk-frame wk-opener">
      <div class="wk-lab" style="--c:var(--amber-d);margin-bottom:var(--s5)"><span class="wk-dot fill"></span><p class="lbl">{c1.info.number} &nbsp;·&nbsp; the organisation</p></div>
      <h2 class="d2">{c1.info.title}</h2>
      <p class="meta">{c1.info.company} &nbsp;·&nbsp; {c1.info.dates}</p>
      <p class="role">{c1.info.role}</p>
      <div class="wk-stats">{c1.stats.map((s) => <div><p class="stat">{s.value}</p><p class="t3">{s.label}</p></div>)}</div>
    </div></section>

    <div class="wk-frame" style="padding-top:76px"><div class="wk-side"><div>
      <div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">The challenge</p></div><div>{P('case1-challenge').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div>
      <div class="wk-rail" style="margin-top:48px"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">My role</p></div><div>{P('case1-role').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div>
      <div class="wk-rail" style="margin-top:56px"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">Commercial accountability</p></div><div><p class="d4" style="max-width:660px">{com1}</p><p class="body" style="margin-top:var(--s5)">{com2}</p>{P('case1-commercial').slice(1).map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div>
      <div class="wk-rail" style="margin-top:64px"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">{c1.info['narrative-label']}</p></div><div>{narr.slice(0, turnIdx).map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div>
    </div><figure class="wk-phone"><img src="/images/work/toyota-app.gif" alt="" width="450" height="964" /><figcaption><span>MyToyota, the home screen</span><span>US build, public app</span></figcaption></figure></div></div>
    <div class="wk-frame wk-fig reveal" style="padding-top:56px"><div class="wk-desk"><Fragment set:html={arc} /></div><div class="wk-mob"><Fragment set:html={arcM} /></div></div>
    <div class="wk-frame" style="padding-top:64px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">Where service design came from</p></div><div><p class="body" set:html={inlineMd(narr[turnIdx])} /><div class="wk-quote"></div><p class="d3" style="max-width:660px">A disjointed end-to-end experience is usually a faithful reflection of a disjointed business.</p></div></div></div>


    <div class="wk-frame" style="padding-top:76px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">What it led to</p></div><div>
      <p class="body" set:html={inlineMd(narr3a)} />
      <div class="wk-inset"><div class="wk-lab" style="--c:var(--teal);margin-bottom:var(--s3)"><span class="wk-dot ring"></span><p class="lbl">The team’s work</p></div><p class="body" set:html={inlineMd(narr3b)} /></div>
      {narr.slice(creditIdx + 1).map((p) => <p class="body" set:html={inlineMd(p)} />)}
    </div></div></div>

    <div class="wk-frame" style="padding-top:88px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">{c1.info['leading-label']}</p></div><div>{P('case1-leading').map((p) => <p class="body" set:html={inlineMd(p)} />)}<div style="margin-top:var(--s6)"><Plate src="/images/work/txd-service-catalogue.png" what="The service catalogue, once the team was fully formed. Three practices, from concept to market." prov="Toyota Experience Design, internal" bare /></div></div></div></div>
    <section class="wk-band wk-band-grad reveal" style="margin-top:88px"><div class="wk-frame wk-fig" style="padding-top:88px"><Fragment set:html={ownership} /></div>
    <div class="wk-frame" style="padding-top:88px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--amber-d)"><span class="wk-dot fill"></span><p class="lbl">{c1.info['people-label']}</p></div><div>{P('case1-people').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame wk-fig" style="padding-top:56px;padding-bottom:88px"><Fragment set:html={people} /></div></section>
    <div class="wk-frame" style="padding-top:88px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">Position and innovation</p></div><div>{P('case1-position').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:56px;padding-bottom:96px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">What changed</p></div><div>{P('case1-impact').map((p) => <p class="body big" set:html={inlineMd(p)} />)}</div></div></div>

    <!-- Case two -->
    <section class="wk-band wk-video wk-photo reveal">
      <img class="wk-video-src" src="/images/work/myt-hand.jpg" alt="" aria-hidden="true" />
      <div class="wk-video-wash" aria-hidden="true"></div>
      <div class="wk-frame wk-opener">
      <div class="wk-lab" style="--c:var(--teal-d);margin-bottom:var(--s5)"><span class="wk-dot ring"></span><p class="lbl">{c2.info.number}</p></div>
      <h2 class="d2">{c2.info.title}</h2>
      <p class="meta">{c2.info.company} &nbsp;·&nbsp; {c2.info.dates}</p>
      <p class="role">{c2.info.role}</p>
      <div class="wk-stats">{c2.stats.map((s) => <div><p class="stat">{s.value}</p><p class="t3">{s.label}</p></div>)}</div>
    </div></section>
    <section class="wk-case2">
    <div class="wk-frame" style="padding-top:76px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">The challenge</p></div><div>{P('case2-challenge').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:48px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--teal)"><span class="wk-dot ring"></span><p class="lbl">Who designed it</p></div><div>{role2.map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:60px;padding-bottom:40px"><div class="wk-rail"><div class="wk-lab"><span class="wk-dot fill"></span><p class="lbl">What that involved</p></div><div class="wk-defgrid" style="max-width:none">{B('case2-approach').map((b) => <div><p class="d4">{b.lead}</p><p class="t2" set:html={inlineMd(b.body)} /></div>)}</div></div></div>

    <div class="wk-frame wk-fig reveal" style="padding-top:40px;padding-bottom:0">
      <h2 class="d2" style="max-width:900px;margin-bottom:var(--s5)">What the team designed</h2>
      <p class="body" style="max-width:700px;margin-bottom:var(--s7)">The team rebuilt the app for European customers. The home screen was redesigned around the tasks people came for, EV charging was brought into one place with live status, and a design system was built underneath both. The chart is their testing and the phone is their home screen.</p>
      <div class="wk-row" style="grid-template-columns:minmax(0,700px) minmax(0,220px);gap:var(--s8);align-items:start;border-top:2px solid var(--teal);padding-top:var(--s5)"><div><Fragment set:html={sus} /></div>
        <div style="align-self:center"><Plate src="/images/work/home-after.png" what="Home, as the team rebuilt it." prov="MyToyota, Europe" bare /></div>
      </div>
    </div>
    <div class="wk-frame" style="padding-top:56px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--teal)"><span class="wk-dot ring"></span><p class="lbl">One finding, and what it taught</p></div><div class="wk-inset"><p class="body">In testing, 92 per cent of participants completed the charge scheduling task and rated its ease at 5.15 against a benchmark of 5.5. The task passed on the numbers, and the sessions still showed a problem. The control that set the schedule said nothing about its outcome, so people set it and could not tell what they had done. One change, a control that states what it will do, served new users and advanced users alike.</p></div></div></div>

    <div class="wk-frame wk-fig reveal" style="padding-top:88px"><Fragment set:html={timeline} /></div>
    <div class="wk-frame wk-fig reveal" style="padding-top:72px;padding-bottom:104px"><div class="wk-row wk-row-2" style="border-top:2px solid var(--amber);padding-top:var(--s5)"><div><Fragment set:html={rating} /></div><div>
      <p class="lbl" style="color:var(--amber);margin-bottom:var(--s4)">What changed</p>
      <p class="body" style="font-size:16px" set:html={inlineMd(P('case2-impact')[0])} />
      <div class="wk-quote"></div><p class="d4" style="max-width:660px" set:html={inlineMd(P('case2-impact')[1])} />
    </div></div></div>

    </section>

    <!-- Case three -->
    <section class="wk-band wk-video wk-photo reveal">
      <img class="wk-video-src" src="/images/work/songkick-live.jpg" alt="" aria-hidden="true" />
      <div class="wk-video-wash" aria-hidden="true"></div>
      <div class="wk-frame wk-opener">
      <div class="wk-lab" style="--c:var(--amber-d);margin-bottom:var(--s5)"><span class="wk-dot fill"></span><p class="lbl">{c3.info.number}</p></div>
      <h2 class="d2">{c3.info.title}</h2>
      <p class="meta">{c3.info.company} &nbsp;·&nbsp; {c3.info.dates}</p>
      <p class="role">{c3.info.role}</p>
      <div class="wk-stats">{c3.stats.map((s) => <div><p class="stat">{s.value}</p><p class="t3">{s.label}</p></div>)}</div>
    </div></section>
    <div class="wk-frame" style="padding-top:76px;padding-bottom:96px"><div class="wk-row-2">
      <div>
        <img class="wk-logo" src="/images/work/songkick-logo.png" alt="Songkick" width="523" height="157" />
        <p class="lbl" style="margin-bottom:var(--s4)">2008 to 2016</p>
        {P('case3-songkick').filter((p) => !p.startsWith('- ')).map((p) => <p class="body" set:html={inlineMd(p)} />)}
        <ul class="wk-list">{bullets(S('case3-songkick')).map((b) => <li set:html={inlineMd(b)} />)}</ul>
        <figure class="wk-phones-stack">
          <div class="stage"><img class="ph2" src="/images/work/songkick-phone-2.png" alt="" /><img class="ph1" src="/images/work/songkick-phone-1.png" alt="" /></div>
          <figcaption><span>Songkick on iOS.</span><span>Shipped product</span></figcaption>
        </figure>
      </div>
      <div>
        <img class="wk-logo" src="/images/work/dopay-logo.png" alt="Dopay" width="375" height="134" />
        <p class="lbl" style="margin-bottom:var(--s4)">2017 to 2018</p>
        {P('case3-dopay').map((p) => <p class="body" set:html={inlineMd(p)} />)}
        <div style="margin-top:var(--s6)"><div class="wk-blend"><Plate src="/images/work/dopay-01.webp" what="Dopay for Business and the employee app." prov="Shipped product" bare /></div></div>
      </div>
    </div></div>

    <!-- Case four -->
    <section class="wk-band reveal"><div class="wk-frame wk-opener wk-fig">
      <div class="wk-lab" style="--c:var(--night-ink);margin-bottom:var(--s5)"><span class="wk-dot fill"></span><p class="lbl">{c4.info.number}</p></div>
      <h2 class="d2">{c4.info.title}</h2>
      <p class="meta">{c4.info.company} &nbsp;·&nbsp; {c4.info.dates}</p>
      <p class="role">{c4.info.role}</p>
      <Fragment set:html={pairing} />
      <div style="height:56px"></div>
      <div class="wk-stats">{c4.stats.map((s) => <div><p class="stat">{s.value}</p><p class="t3">{s.label}</p></div>)}</div>
    </div></section>
    <div class="wk-frame" style="padding-top:76px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">The challenge</p></div><div>{P('case4-challenge').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:48px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">My role</p></div><div>{P('case4-role').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:64px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">{c4.info['narrative-label']}</p></div><div>{P('case4-narrative').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:64px"><div class="wk-row-2 wk-uniform">
      <Plate src="/images/work/emotrix-site.jpg" what="emotrix.cloud, the page on method. The timeline is illustrative, hatched where the face was not resolvable." prov="Live site, September 2026" />
      <Plate src="/images/work/prepcall-home.jpg" what="PrepCall, the front page." prov="Live product, September 2026" />
    </div></div>
    <div class="wk-frame" style="padding-top:72px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">What I learned building it</p></div><div class="wk-defgrid" style="max-width:none">{B('case4-approach').map((b) => <div><p class="d4">{b.lead}</p><p class="t2" set:html={inlineMd(b.body)} /></div>)}</div></div></div>
    <div class="wk-frame" style="padding-top:72px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">{c4.info['aside-label']}</p></div><div class="wk-box">{P('case4-hard').map((p) => <p class="body" style="font-size:16px" set:html={inlineMd(p)} />)}</div></div></div>
    <div class="wk-frame" style="padding-top:60px;padding-bottom:0"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">Where PrepCall stands</p></div><div>{P('case4-impact').map((p) => <p class="body big" set:html={inlineMd(p)} />)}</div></div></div>

    <!-- Governance -->
    <div class="wk-frame" style="padding-top:72px;padding-bottom:112px"><div class="wk-rail"><div class="wk-lab" style="--c:var(--ink)"><span class="wk-dot fill"></span><p class="lbl">Governance</p></div><div>
      {P('governance').map((p) => <p class="body" set:html={inlineMd(p)} />)}
      <div class="wk-gov">{gov.map(([a, b]) => <div><p style="font-size:14px;font-weight:600;color:var(--ink);margin-bottom:4px">{a}</p><p class="t3" style="font-size:12.5px">{b}</p></div>)}</div>
    </div></div></div>

    <!-- Closing -->
    <section class="wk-band reveal"><div class="wk-frame" style="padding-top:96px;padding-bottom:96px">
      <p class="lbl" style="color:var(--amber-d);margin-bottom:var(--s5)">The pattern</p>
      <p style="font-size:20px;line-height:1.8;color:var(--night-body);margin-bottom:var(--s7)" set:html={inlineMd(closing[0])} />
      <p style="font-size:17px;line-height:1.8;color:var(--night-muted);max-width:840px;margin-bottom:var(--s6)">The last part is the one people underestimate.</p>
      <p class="d2" style="color:var(--night-ink);max-width:1080px">Much of what I am proudest of was designed by somebody else.</p>
    </div></section>

    <!-- Contact -->
    <div class="wk-frame" style="padding-top:96px;padding-bottom:76px">
      <p class="lbl" style="margin-bottom:var(--s4)">Contact</p>
      <p class="d4" style="font-size:24px;max-width:760px;margin-bottom:var(--s5)" set:html={inlineMd(contact[0])} />
      <p class="body" style="max-width:760px" set:html={linkifyContact(contact[1])} />
    </div>
    <script is:inline>(function(){function go(){var els=document.querySelectorAll('.wk-anim');if(!els.length)return;if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('is-on')});return;}els.forEach(function(e){var t=Math.min(0.98,(window.innerHeight*0.92)/Math.max(1,e.offsetHeight));var io=new IntersectionObserver(function(entries){entries.forEach(function(en){if(en.isIntersecting&&en.intersectionRatio>=t-0.01){e.classList.add('is-on');io.disconnect();}});},{threshold:[t]});io.observe(e);});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',go);}else{go();}})();</script>
  </main>
  <Footer />
</Base>
