---
import Base from '../layouts/Base.astro';
import Footer from '../layouts/Footer.astro';
import ArticleRow from '../layouts/ArticleRow.astro';
import {
  loadHomepage,
  parseKV,
  paragraphs,
  bullets,
  inlineMd,
  linkifyContact,
  projectHref,
} from '../lib/homepage.mjs';
import {
  allArticles,
  homepageArticles,
  categoryLabel,
  imagePath,
} from '../lib/articles.mjs';

const { meta, sections } = loadHomepage();
const articles = await allArticles();
const homeList = homepageArticles(articles);

const leftCol = paragraphs(sections['left-column']);
const rightCol = paragraphs(sections['right-column']);
const about = paragraphs(sections['about']);
const aiHeading = sections['ai-behaviour-heading'].trim();
const aiBehaviour = paragraphs(sections['ai-behaviour']);
const earlierWork = paragraphs(sections['earlier-work']);
const cases = paragraphs(sections['cases']);
const craft = sections['craft-delivery'];
const org = sections['organisation-operations'];
const leadership = sections['leadership-influence'];
const projects = Object.keys(sections)
  .filter((k) => k.startsWith('project-'))
  .map((k) => parseKV(sections[k]));
const contact = paragraphs(sections['contact']);
---
<Base
  title="Gideon Bullock · Product & Design Leader"
  description="Twenty-five years building design and product organisations, leading transformation and the innovation pathways that decide what gets funded. Employee seven at Songkick. A forty-person function with its own P&L at Toyota."
  ogImage="/images/headshot-frames/all-four-faces-gemini-face02.png"
  path="/"
  nav="home"
>
  <main id="home-page" class="page active">

    <!-- Hero -->
    <section class="hero hero-animate">
      <div class="container">
        <div class="hero-layout">
          <div class="hero-text">
            <p class="section-label">{meta.label}</p>
            <h1>{meta.name}</h1>
            <p class="tagline">{meta.tagline}</p>
            {meta.proof && <p class="hero-proof">{meta.proof}</p>}
          </div>
          <div class="portrait-wrapper">
            <img src="/images/portrait.png" alt="Gideon Bullock" width="600" height="600">
          </div>
        </div>

        <div class="status-cards">
          <div class="status-card">
            <div class="card-label">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              Currently
            </div>
            <p>{paragraphs(sections['currently'])[0]}</p>
            <ul class="status-list">
              {bullets(sections['currently']).map((li) => <li set:html={inlineMd(li)} />)}
            </ul>
          </div>
          <div class="status-card">
            <div class="card-label">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              Previously
            </div>
            <p>{sections['previously']}</p>
          </div>
        </div>

        <div class="logos-section reveal" style="margin-top:40px;padding:0">
          <p class="section-label">Places I've Worked</p>
          <img src="/images/logos-prev.png" alt="Logos of the BBC, Skype, Songkick and Toyota" style="height:65px;margin-top:12px;opacity:0.7">
        </div>
      </div>
    </section>

    <!-- Work -->
    <section id="work" style="padding-top:32px">
      <div class="container">
        <div class="case-study reveal">
          <div class="case-header">
            <div>
              <p class="case-number">Work</p>
            </div>
            <div>
              {cases.map((p) => (
                <div class="case-block">
                  <p set:html={inlineMd(p)} />
                </div>
              ))}
              <div style="margin-top:8px">
                <a href="/work/" class="view-all-link">Read the four cases <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align:middle"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
          </div>
        </div>

        <div class="divider" style="margin:0"></div>

        <div class="case-study reveal">
          <div class="case-header">
            <div>
              <p class="case-number">Earlier Work</p>
            </div>
            <div>
              <div class="case-block"><p set:html={inlineMd(earlierWork[0])} /></div>
              <div style="margin-top:8px">
                <a href="/work/songkick-dopay/" class="view-all-link">Read case three <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align:middle"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- Projects -->
    <section id="projects">
      <div class="container">
        <p class="section-label reveal">Projects</p>
        <h2 class="reveal">Things I've built</h2>

        <div class="project-index reveal">
          {projects.map((p) => (
            <div class="project-row">
              <h3 class="project-name">{p['slug'] ? <a href={`/work/${p['slug']}/`}>{p['name']}</a> : p['link'] ? <a href={projectHref(p['link'])}>{p['name']}</a> : p['name']}</h3>
              <p class="project-description">{p['description'].split(/(?<=\.)\s/)[0]}</p>
            </div>
          ))}
        </div>
        <div class="reveal" style="margin-top:32px">
          <a href="/work/#projects" class="view-all-link">All projects <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align:middle"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>

      </div>
    </section>

    <div class="divider"></div>

    <!-- Expertise -->
    <section id="expertise">
      <div class="container">
        <div class="expertise-intro">
          <p class="section-label reveal">Expertise</p>
          <h2 class="reveal">What I focus on</h2>
        </div>

        <div class="skill-group reveal">
          <h3>Craft &amp; Delivery</h3>
          <div>
            <ul class="skill-list">
              {bullets(craft).map((li) => <li set:html={inlineMd(li)} />)}
            </ul>
          </div>
        </div>
        <div class="skill-group reveal">
          <h3>Organisation &amp; Operations</h3>
          <div>
            <ul class="skill-list">
              {bullets(org).map((li) => <li set:html={inlineMd(li)} />)}
            </ul>
          </div>
        </div>
        <div class="skill-group reveal">
          <h3>Leadership &amp; Influence</h3>
          <div>
            <ul class="skill-list">
              {bullets(leadership).map((li) => <li set:html={inlineMd(li)} />)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="divider" style="margin-top:-40px"></div>

    <!-- Approach -->
    <section id="approach" class="philosophy">
      <div class="container">
        <p class="section-label reveal">Approach</p>
        <h2 class="reveal" style="margin-bottom:32px">How I think about the job</h2>
        <div class="two-col">
          <div>
            {leftCol.map((p, i) => (
              <p class="body-text reveal" style={i > 0 ? 'margin-top:24px' : undefined} set:html={inlineMd(p)} />
            ))}
          </div>
          <div>
            {rightCol.map((p, i) => (
              <p class="body-text reveal" style={i > 0 ? 'margin-top:24px' : undefined} set:html={inlineMd(p)} />
            ))}
          </div>
          <h3 class="project-name approach-subhead reveal">{aiHeading}</h3>
          <div>
            <p class="body-text reveal" set:html={inlineMd(aiBehaviour[0])} />
          </div>
          <div>
            {aiBehaviour.slice(1).map((p, i) => (
              <p class="body-text reveal" style={i > 0 ? 'margin-top:24px' : undefined} set:html={inlineMd(p)} />
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- About -->
    <section class="philosophy">
      <div class="container">
        <p class="section-label reveal">About</p>
        {about.map((p, i) => (
          <p class="body-text reveal" style={i > 0 ? 'max-width:620px;margin-top:24px' : 'max-width:620px'} set:html={inlineMd(p)} />
        ))}
      </div>
    </section>

    <div class="divider"></div>

    <!-- Writing -->
    <section id="writing">
      <div class="container">
        <div class="writing-intro">
          <p class="section-label reveal">Writing</p>
          <h2 class="reveal">Thinking out loud</h2>
          <p class="body-text reveal" set:html={inlineMd(sections['writing-intro'])} />
        </div>
        <div id="articles-list">
          {homeList.map((a) => (
            <ArticleRow
              slug={a.id}
              title={a.data.title}
              category={categoryLabel(a.data.category)}
              readTime={a.data.readTime}
              thumb={imagePath(a.data.image)}
              reveal={true}
            />
          ))}
        </div>
        <div class="reveal" style="margin-top:32px">
          <a href="/writing/" class="view-all-link">View all writing <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="vertical-align:middle"><path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact">
      <div class="container">
        <p class="section-label reveal">Get in Touch</p>
        <p class="bold-statement reveal" set:html={inlineMd(contact[0])} />
        <p class="body-text reveal" set:html={linkifyContact(contact[1])} />
      </div>
    </section>

    <Footer />
  </main>
</Base>
