---
// Shared shell: head (per-page metadata), sticky header, hash-redirect shim.
// Footer is rendered by pages that have one (the old article view had none).
interface Props {
  title: string;
  description: string;
  ogImage: string; // site-relative path, e.g. /images/article-10.png
  ogType?: 'website' | 'article';
  path: string; // site-relative canonical path, e.g. /writing/after-the-app-grid/
  nav?: 'home' | 'article' | 'writing' | 'work';
}
const { title, description, ogImage, ogType = 'website', path, nav = 'home' } = Astro.props;
const site = 'https://gideonb.me';
const canonical = site + path;
const ogImageAbs = site + ogImage;
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // Redirect legacy SPA hash routes (#article/<slug>, #writing) to real
    // URLs. Runs before paint; fragments never reach the server, so this
    // must live on the client.
    (function () {
      var h = window.location.hash;
      var m = h.match(/^#article\/([A-Za-z0-9-]+)/);
      if (m) {
        window.location.replace('/writing/' + m[1] + '/');
      } else if (h === '#writing' && window.location.pathname === '/') {
        window.location.replace('/writing/');
      }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:site_name" content="Gideon Bullock" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class:list={{ "wide-page": nav === "work" }}>

  <header id="site-header">
    <div class="header-inner">
      <a href="/" class="logo">GB</a>
      <nav id="main-nav">
        {nav !== 'home' && (
          <a href="/" class="nav-home">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 4L6 8L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Home
          </a>
        )}
        <a href="/work/" style={nav === 'work' ? 'color:#1e1a16' : undefined}>Work</a>
        <a href="/writing/" style={nav === 'writing' ? 'color:#1e1a16' : undefined}>Writing</a>
      </nav>
    </div>
  </header>

  <div id="page-container">
    <slot />
  </div>

  <script is:inline src="/site.js"></script>
  <Analytics />
</body>
</html>
