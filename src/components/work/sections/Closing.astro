---
// The pattern, on the night band.
import { inlineMd } from '../../../lib/homepage.mjs';
interface Props { w: any }
const { w } = Astro.props;
const { closing } = w;
---
    <!-- Closing -->
    <section class="wk-band reveal"><div class="wk-frame" style="padding-top:96px;padding-bottom:96px">
      <p class="lbl" style="color:var(--amber-d);margin-bottom:var(--s5)">The pattern</p>
      <p style="font-size:20px;line-height:1.8;color:var(--night-body);margin-bottom:var(--s7)" set:html={inlineMd(closing[0])} />
      <p style="font-size:17px;line-height:1.8;color:var(--night-muted);max-width:840px;margin-bottom:var(--s6)">The last part is the one people underestimate.</p>
      <p class="d2" style="color:var(--night-ink);max-width:1080px">Much of what I am proudest of was designed by somebody else.</p>
    </div></section>
