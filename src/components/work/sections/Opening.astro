---
// The intro and the authorship gauge. Used by the hub and the single-scroll view.
import { inlineMd } from '../../../lib/homepage.mjs';
import gauge from '../gauge.html?raw';
import { AUTH } from '../../../lib/work.mjs';
interface Props { w: any }
const { w } = Astro.props;
const { meta, intro, gaugeCards } = w;
---
    <!-- Opening -->
    <div class="wk-frame" style="padding-top:96px">
      <p class="lbl" style="margin-bottom:var(--s4)">{meta.label}</p>
      <h1 class="d1" style="margin-bottom:var(--s6)">{meta.title}</h1>
      <p style="font-size:21px;line-height:1.65;color:var(--body);max-width:720px;margin-bottom:var(--s5)" set:html={inlineMd(intro[0])} />
      <p style="font-size:16px;line-height:1.8;color:var(--muted);max-width:720px" set:html={inlineMd(intro[1])} />
    </div>
    <div class="wk-frame" style="padding-top:64px;padding-bottom:96px">
      <div class="wk-desk"><Fragment set:html={gauge} /></div>
      <div class="wk-gauge">
        {gaugeCards.map(([n, t, info, note, auth]) => (
          <div>
            <div class="wk-lab" style="margin-bottom:var(--s2)"><span class:list={['wk-auth', auth]}><i aria-hidden="true"></i>{AUTH[auth]}</span><p class="lbl">{n}</p></div>
            <p class="d4">{t}</p>
            <p class="t3">{info.company} &nbsp;·&nbsp; {info.dates}</p>
            <p class="t2">{note}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:var(--s7);padding-top:var(--s5);border-top:1px solid var(--rule);max-width:840px"><p class="t3" style="font-size:14px" set:html={inlineMd(intro[2])} /></div>
    </div>
