---
// Case four: PrepCall and Emotrix, with the governance block that closes it, in the document
// register. `extended` adds the context growth chart after "What I learned building it".
import Plate from '../Plate.astro';
import Opener from '../doc/Opener.astro';
import Block from '../doc/Block.astro';
import { inlineMd } from '../../../lib/homepage.mjs';
import pairing from '../pairing.html?raw';
import ctx from '../ctx.html?raw';
interface Props { w: any; extended?: boolean }
const { w, extended = false } = Astro.props;
const { P, B, c4, gov } = w;
const info = c4.info;
---
    <!-- Case four -->
    <section id="case-four" data-theme="dark" class="wk-band reveal"><div class="wk-frame wk-opener wk-fig">
      <div class="wk-lab" style="margin-bottom:var(--s5)"><span class="wk-auth mine"><i aria-hidden="true"></i>my call</span><p class="lbl">{c4.info.number}</p></div>
      <h2 class="d2">{c4.title.quiet && <span class="tt-quiet">{c4.title.quiet}</span>}{c4.title.quiet && ' '}{c4.title.loud}</h2>
      <p class="meta">{c4.info.company} &nbsp;·&nbsp; {c4.info.dates}</p>
      <p class="role">{c4.info.role}</p>
      <Fragment set:html={pairing} />
      <div style="height:56px"></div>
      <div class="wk-stats">{c4.stats.map((s) => <div><p class="stat">{s.value}</p><p class="t3">{s.label}</p></div>)}</div>
    </div></section>
    <Block info={info} k="challenge" style="padding-top:76px">{P('case4-challenge').map((p) => <p class="body" set:html={inlineMd(p)} />)}</Block>
    <Block info={info} k="role">{P('case4-role').map((p) => <p class="body" set:html={inlineMd(p)} />)}</Block>

    <Opener info={info} k="narrative" />
    <Block info={info} k="narrative" under>{P('case4-narrative').map((p) => <p class="body" set:html={inlineMd(p)} />)}</Block>
    <div class="wk-frame doc-evidence"><div class="wk-row-2 wk-uniform">
      <Plate src="/images/work/emotrix-site.jpg" what="emotrix.cloud, the page on method. The timeline is illustrative, hatched where the face was not resolvable." prov="Live site, September 2026" />
      <Plate src="/images/work/prepcall-home.jpg" what="PrepCall, the front page." prov="Live product, September 2026" />
    </div></div>
    <Block info={info} k="learned" style="padding-top:var(--s8)"><div class="wk-defgrid">{B('case4-approach').map((b) => <div><p class="d4">{b.lead}</p><p class="t2" set:html={inlineMd(b.body)} /></div>)}</div></Block>
    {extended && (
    <div class="wk-frame doc-evidence wk-fig reveal"><div style="max-width:748px"><Fragment set:html={ctx} /></div></div>
    )}
    <Block info={info} k="aside" style="padding-top:var(--s8)"><div class="wk-box">{P('case4-hard').map((p) => <p class="body" set:html={inlineMd(p)} />)}</div></Block>
    <Block info={info} k="prepcall">{P('case4-impact').map((p) => <p class="body big" set:html={inlineMd(p)} />)}</Block>

    <!-- Governance -->
    <Block info={info} k="governance" style="padding-top:var(--s8);padding-bottom:112px">
      {P('governance').map((p) => <p class="body" set:html={inlineMd(p)} />)}
      <div class="wk-gov">{gov.map(([a, b]) => <div><p style="font-size:14px;font-weight:600;color:var(--ink);margin-bottom:4px">{a}</p><p class="t3" style="font-size:12.5px">{b}</p></div>)}</div>
    </Block>
