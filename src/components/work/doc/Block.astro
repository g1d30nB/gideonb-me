---
// One block of the document register: the rail, then the prose at the measure, then air. The
// rail label comes from <k>-label in the case's meta block; <k>-meta, where a block has one, is a
// second mono line under it (case three's dates). There is no meta column: held to the rule that
// it never repeats what is on the same screen, it had one real entry across four cases. `under` marks the first block under an opener: its rail shows the label only once the
// opener has its own heading, so the same words never sit twice in one screen. `auth` puts the
// authorship unit in the rail where a block's authorship differs from its case.
import { AUTH } from '../../../lib/work.mjs';
interface Props { info: Record<string, string>; k?: string; under?: boolean; auth?: 'mine' | 'team' | 'shared'; style?: string }
const { info, k = '', under = false, auth, style } = Astro.props;
const label = k ? info[`${k}-label`] || '' : '';
const shown = under && !info[`${k}-heading`] ? '' : label;
const meta = k ? info[`${k}-meta`] || '' : '';
---
<div class="wk-frame doc" style={style}><div class="doc-rail">{auth && <span class:list={['wk-auth', auth]}><i aria-hidden="true"></i>{AUTH[auth]}</span>}{shown && <p class="lbl">{shown}</p>}{meta && <p class="doc-rail-meta">{meta}</p>}</div><div class="doc-body"><slot /></div></div>
